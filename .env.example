# ==============================================================================
# منصة الأستاذة تبارك الأزيرجاوي — ملف متغيرات البيئة النموذجي (.env.example)
# انسخ هذه المتغيرات إلى ملف .env.local (أو إعدادات Secrets) واملأ قيمك الحقيقية
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only)
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""

# ==============================================================================
# 1. إعدادات Supabase (تُحفظ في .env.local)
# ==============================================================================
VITE_SUPABASE_URL="https://ffyoyacdkljvzcctoiwg.supabase.co"
# ضع هنا مفتاح Supabase Publishable الذي يبدأ بـ sb_publishable_ أو anon key
VITE_SUPABASE_ANON_KEY=""
# مفتاح اختياري للخادم فقط (لا يبدأ بـ VITE_) للتحقق من اشتراك الطالب داخل /api/livekit/token
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# 2. إعدادات LiveKit للبث المباشر (خادم فقط — محمية ولا تُكشف للواجهة الأمامية)
# ==============================================================================
# رابط WebSocket الخاص بـ LiveKit (يبدأ بـ wss://)
LIVEKIT_URL=""
# مفتاح API الخاص بـ LiveKit (Server-side only)
LIVEKIT_API_KEY=""
# السر الخاص بـ LiveKit (Server-side only — لا تضعه أبداً مع VITE_)
LIVEKIT_API_SECRET=""

# مسار نقطة النهاية الآمنة لتوليد توكن LiveKit (افتراضياً /api/livekit/token أو رابط Supabase Edge Function)
VITE_LIVEKIT_TOKEN_ENDPOINT="/api/livekit/token"

# ==============================================================================
# 3. بيانات السوبر أدمن الاختيارية (خادم فقط — لا تبدأ بـ VITE_)
# ==============================================================================
SUPER_ADMIN_PHONE=""
SUPER_ADMIN_PASSWORD=""

# ==============================================================================
# فصل وضع التطبيق (اختياري: student للـ APK أو admin لبوابة الويب أو فارغ للوضع الافتراضي)
# ==============================================================================
VITE_APP_MODE=""
